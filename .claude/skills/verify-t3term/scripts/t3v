#!/usr/bin/env python3
"""t3v: runs the real t3term TUI in tmux against a fake T3 server. `t3v --help` lists the commands."""

import os
import sys

# First on the path by hand, so `python3 -I t3v` finds the package beside this file.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from t3v_lib.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
